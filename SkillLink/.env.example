# Variables de entorno de la API SkillLink (copiar a .env o exportar). Ningun valor aqui es secreto.
SPRING_PROFILES_ACTIVE=local            # local (H2) | dev (PostgreSQL local) | prod (PostgreSQL por variables)
PORT=8080
# --- Resource Server (Microsoft Entra ID, tenant DuocUC)
JWT_ISSUER=https://login.microsoftonline.com/72fd0b5a-8a6a-4cff-89f6-bde961f7e250/v2.0
JWT_AUDIENCE=393a4087-9e4d-41c4-a0ce-1755b1ba0d2f,api://393a4087-9e4d-41c4-a0ce-1755b1ba0d2f
JWT_JWK_SET_URI=https://login.microsoftonline.com/72fd0b5a-8a6a-4cff-89f6-bde961f7e250/discovery/v2.0/keys
APP_READ_SCOPE=skilllink.read
APP_WRITE_SCOPE=skilllink.write
APP_ADMIN_ROLE=ADMIN
# --- CORS (acceso directo al backend)
CORS_ALLOWED_ORIGINS=http://localhost:4200
# --- Base de datos (solo perfiles dev/prod)
DB_URL=jdbc:postgresql://localhost:5432/skilllink
DB_USERNAME=postgres
DB_PASSWORD=cambiar
DDL_AUTO=update
APP_SEED_ENABLED=true
